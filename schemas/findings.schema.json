{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "findings",
  "type": "object",
  "required": [
    "change_id",
    "iteration",
    "scope",
    "findings",
    "verdict"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "scope": {
      "enum": [
        "full",
        "delta"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "severity",
          "req_ids",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "closed"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor",
              "info",
              "warning",
              "nit"
            ]
          },
          "req_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "changes_requested",
        "approved",
        "pass",
        "accept"
      ]
    }
  }
}
